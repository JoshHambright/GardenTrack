{
  "name": "gardentrack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "typecheck": "tsc --build --force && pnpm --filter @gardentrack/web check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "pnpm --filter @gardentrack/web build",
    "dev": "pnpm --filter @gardentrack/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
